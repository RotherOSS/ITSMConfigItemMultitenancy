<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Config">

    <Setting Name="ITSMConfigItemManagementGroup" Required="0" Valid="1">
        <Description Translatable="1">Management group that exempts from any config item level group restrictions.</Description>
        <Navigation>Core::GeneralCatalog</Navigation>
        <Value>
            <Item ValueType="String">itsm-configitem-manager</Item>
        </Value>
    </Setting>
    <Setting Name="GeneralCatalogPreferences###ConfigitemGroup" Required="0" Valid="1">
        <Description Translatable="1">Mode for config item level group restrictions.</Description>
        <Navigation>Core::GeneralCatalog</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::GeneralCatalogPreferences::Generic</Item>
                <Item Key="Class">ITSM::ConfigItem::Class</Item>
                <Item Key="Label" Translatable="1">Config Item Group</Item>
                <Item Key="Priority">25</Item>
                <Item Key="Desc" Translatable="1">Set mode for config item level group restrictions.</Item>
                <Item Key="Data">
                    <Hash>
                        <Item Key="0" Translatable="1">Disabled</Item>
                        <Item Key="1" Translatable="1">Enabled</Item>
                        <Item Key="2" Translatable="1">Enabled and required</Item>
                    </Hash>
                </Item>
                <Item Key="PrefKey">ConfigItemGroup</Item>
                <Item Key="Block">Option</Item>
                <Item Key="Mandatory" ValueType="Checkbox">1</Item>                
            </Hash>
        </Value>
    </Setting>    
    <Setting Name="GeneralCatalogPreferences###VersionTrigger" Required="0" Valid="1">
        <Description Translatable="1">Parameters for the version trigger for config item classes in the preferences view of the agent interface.</Description>
        <Navigation>Core::GeneralCatalog</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::GeneralCatalogPreferences::Generic</Item>
                <Item Key="Class">ITSM::ConfigItem::Class</Item>
                <Item Key="Label" Translatable="1">Version Trigger</Item>
                <Item Key="Priority">70</Item>
                <Item Key="Desc" Translatable="1">Choose attributes to trigger the creation of a new version.</Item>
                <Item Key="Data">
                    <Hash>
                        <Item Key="Name" Translatable="1">Name</Item>
                        <Item Key="DeplStateID" Translatable="1">DeploymentState</Item>
                        <Item Key="InciStateID" Translatable="1">IncidentState</Item>
                        <Item Key="DefinitionUpdate" Translatable="1">Definition Update</Item>
                        <!-- HERE -->
                        <Item Key="GroupID" Translatable="1">Group</Item>
                    </Hash>
                </Item>
                <Item Key="PrefKey">VersionTrigger</Item>
                <Item Key="Block">ConfigItemVersionTrigger</Item>
                <Item Key="Mandatory" ValueType="Checkbox">0</Item>
                <Item Key="Multiple" ValueType="Checkbox">1</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="ITSMConfigItem::Permission::Item###010-ItemGroupCheck" Required="0" Valid="1">
        <Description Translatable="1">Module to check the group responsible for an individual instance of a configuration item.</Description>
        <Navigation>Core::ITSMConfigItem</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::System::ITSMConfigItem::Permission::ItemGroupCheck</Item>
                <Item Key="Required">0</Item>
                <Item Key="Granted">1</Item>
            </Hash>
        </Value>
    </Setting>

</otobo_config>
